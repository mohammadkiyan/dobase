<% content_for :title, _("Welcome - %{app_name}", app_name: app_name) %>

<div class="w-full max-w-sm">
  <div class="text-center mb-8">
    <%= render "shared/logo", class: "w-16 h-16 mx-auto mb-4" %>
    <h1 class="text-2xl font-semibold text-text-primary"><%= _("Welcome, %{first_name}", first_name: @user.first_name) %></h1>
    <p class="text-text-secondary mt-1"><%= _("Choose a password for %{email}", email: @user.email_address) %></p>
  </div>

  <div class="auth-card">
    <div class="card-body">
      <%= render "shared/flash", position: :inline %>
      <%= form_with url: welcome_path(params[:token]), method: :patch, class: "space-y-4" do |f| %>
        <%# For the browser's password manager %>
        <%= hidden_field_tag :username, @user.email_address, autocomplete: "username", id: nil %>
        <div>
          <label for="password" class="label"><%= _("Password") %></label>
          <%= f.password_field :password, class: "input", placeholder: _("At least 8 characters"),
                required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
          <p class="help-text"><%= _("Must be at least 8 characters") %></p>
        </div>
        <div>
          <label for="password_confirmation" class="label"><%= _("Confirm Password") %></label>
          <%= f.password_field :password_confirmation, class: "input", placeholder: _("Confirm your new password"),
                required: true, autocomplete: "new-password", maxlength: 72 %>
        </div>
        <%= render "components/button", text: _("Sign in"), full_width: true %>
      <% end %>
    </div>
  </div>
</div>
