<% content_for :title, _("Admin - %{app_name}", app_name: app_name) %>
<% content_for :page_title, _("Admin") %>

<div class="p-6 max-w-4xl">
  <%= render "admin/header" do %>
    <%= render "components/button", text: _("New person"), icon: "plus", href: new_admin_user_path %>
  <% end %>

  <div class="card">
    <div class="divide-y divide-border-light">
      <% @users.each do |user| %>
        <div class="card-row group px-5 py-4 flex items-center gap-4" data-arrow-keys-target="item">
          <%= render "shared/avatar", user: user, size: :md %>
          <div class="flex-1 min-w-0">
            <%= link_to user.name, admin_user_path(user), class: "font-medium text-text-primary hover:text-accent after:absolute after:inset-0" %>
            <p class="text-sm text-text-secondary truncate"><%= user.email_address %></p>
          </div>
          <% if user.welcome_pending? %>
            <%= render "components/badge", text: _("Not signed in yet"), variant: :warning, size: :sm %>
          <% end %>
          <% if user.admin? %>
            <%= render "components/badge", text: _("Admin"), variant: :muted, size: :sm %>
          <% end %>
          <%= render "shared/icon", name: "chevron-right", size: 16, class: "text-text-tertiary flex-shrink-0" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
