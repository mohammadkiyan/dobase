<% content_for :title, _("New person - %{app_name}", app_name: app_name) %>
<% content_for :page_title, _("New person") %>
<% templates = UserTemplate.order(:name) %>

<div class="p-6 max-w-2xl space-y-6">
  <%= render "components/back_link", href: admin_users_path, text: _("People") %>

  <div>
    <h1 class="text-xl font-semibold text-text-primary"><%= _("New person") %></h1>
    <p class="text-text-secondary"><%= _("Their account is made with the template's tools. You get a link to send them, with which they choose a password.") %></p>
  </div>

  <div class="card">
    <div class="card-body">
      <%= form_with model: @setup, url: admin_users_path, scope: :user_setup, class: "group space-y-4" do |f| %>
        <%= render "shared/error_flash", object: @setup %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <%= render "components/form_field", label: _("First Name"), name: "user_setup[first_name]", id: "user_setup_first_name",
                value: @setup.first_name, required: true, autofocus: true, object: @setup, field: :first_name %>
          <%= render "components/form_field", label: _("Last Name"), name: "user_setup[last_name]", id: "user_setup_last_name",
                value: @setup.last_name, required: true, object: @setup, field: :last_name %>
        </div>

        <%= render "components/form_field", label: _("Email"), name: "user_setup[email_address]", id: "user_setup_email_address",
              type: :email, value: @setup.email_address, required: true, object: @setup, field: :email_address,
              help: _("They sign in with it.") %>

        <div class="form-field">
          <%= f.label :user_template_id, _("Template"), class: "label" %>
          <%= f.select :user_template_id, {}, {}, class: "input" do %>
            <%= tag.option _("No template: no tools"), value: "" %>
            <% templates.each do |template| %>
              <%= tag.option template.name, value: template.id, selected: template.id == @setup.user_template_id || nil,
                    data: { mail: template.mail? || nil, make_mailbox: (template.mail? && template.make_mailbox?) || nil } %>
            <% end %>
          <% end %>
          <p class="help-text">
            <%= _("The tools they start with.") %>
            <%= link_to _("Manage templates"), admin_user_templates_path, class: "text-accent hover:underline" %>
          </p>
        </div>

        <%# Only a template with a mailbox asks about it, and only one that exists asks for its login %>
        <fieldset class="hidden group-has-[option[data-mail]:checked]:block space-y-4 border-t border-border-light pt-4">
          <legend class="text-sm font-semibold text-text-primary"><%= _("Their mailbox") %></legend>
          <div class="space-y-1">
            <%= render "components/form_field", label: _("Email address"), name: "user_setup[mail_address]", id: "user_setup_mail_address",
                  type: :email, value: @setup.mail_address, object: @setup, field: :mail_address %>
            <p class="help-text group-has-[option[data-make-mailbox]:checked]:hidden"><%= _("Leave empty when it's the address above.") %></p>
            <% if MailServer.configured? %>
              <p class="help-text hidden group-has-[option[data-make-mailbox]:checked]:block">
                <%= _("A new mailbox at %{domain} is made for them. Leave empty for the name of the address above at %{domain}.", domain: MailServer.domain) %>
              </p>
            <% end %>
          </div>
          <div class="space-y-4 group-has-[option[data-make-mailbox]:checked]:hidden">
            <%= render "components/form_field", label: _("Username"), name: "user_setup[mail_username]", id: "user_setup_mail_username",
                  value: @setup.mail_username, help: _("Leave empty when it's the email address.") %>
            <%= render "components/form_field", label: _("Password"), name: "user_setup[mail_password]", id: "user_setup_mail_password",
                  type: :password, autocomplete: "new-password", object: @setup, field: :mail_password,
                  help: _("The mailbox's password. It's kept encrypted, and they never see it.") %>
          </div>
        </fieldset>

        <label class="flex items-center gap-3 cursor-pointer">
          <%= f.check_box :admin, class: "w-4 h-4 rounded border-border text-accent focus:ring-accent/20" %>
          <span class="text-sm text-text-primary"><%= _("An admin: can make accounts too") %></span>
        </label>

        <div class="flex items-center justify-end gap-3 pt-2">
          <%= render "components/button", text: _("Cancel"), href: admin_users_path, variant: :secondary %>
          <%= render "components/button", text: _("Make account"), icon: "user-plus" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
