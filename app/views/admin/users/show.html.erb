<% content_for :title, _("%{name} - %{app_name}", name: @user.name, app_name: app_name) %>
<% content_for :page_title, @user.name %>

<div class="p-6 max-w-3xl space-y-6">
  <%= render "components/back_link", href: admin_users_path, text: _("People") %>

  <div class="flex items-center gap-4">
    <%= render "shared/avatar", user: @user, size: :lg %>
    <div class="flex-1 min-w-0">
      <h1 class="text-xl font-semibold text-text-primary"><%= @user.name %></h1>
      <p class="text-text-secondary truncate"><%= @user.email_address %></p>
    </div>
    <% if @user.admin? %>
      <%= render "components/badge", text: _("Admin"), variant: :muted %>
    <% end %>
  </div>

  <% if @welcome_link %>
    <div class="card">
      <div class="card-body space-y-3">
        <h2 class="font-semibold text-text-primary"><%= _("Welcome link") %></h2>
        <p class="text-sm text-text-secondary">
          <%= _("Send this link to %{name}. With it they choose a password and sign in. It works once, until %{date}.",
                name: @user.first_name, date: format_date(User::WELCOME_LINK_LIFETIME.from_now)) %>
        </p>
        <div class="flex gap-2" data-controller="clipboard">
          <input type="text" readonly aria-label="<%= _("Welcome link") %>" value="<%= @welcome_link %>" class="input flex-1" dir="ltr" data-clipboard-target="source">
          <%= render "components/button", text: _("Copy"), variant: :secondary, size: :sm, type: :button, data: { action: "clipboard#copy", clipboard_target: "button" } %>
        </div>
        <p class="text-xs text-text-tertiary"><%= _("Every visit to this page makes a new link; the earlier ones keep working until a password is chosen.") %></p>
      </div>
    </div>
  <% else %>
    <p class="text-sm text-text-secondary"><%= _("%{name} has chosen a password. If they forget it, they can reset it from the sign-in page.", name: @user.first_name) %></p>
  <% end %>

  <div class="card">
    <div class="card-body">
      <div class="flex items-baseline justify-between gap-4 mb-1">
        <h2 class="font-semibold text-text-primary"><%= _("Tools") %></h2>
        <% if @memberships.any? %>
          <span class="text-sm text-text-secondary">
            <%= n_("%{active} of %{count} tool in use", "%{active} of %{count} tools in use", @memberships.size,
                  active: @memberships.count(&:active?)) %>
          </span>
        <% end %>
      </div>
      <p class="help-text mb-3"><%= n_("In use: opened in the last %{count} day.", "In use: opened in the last %{count} days.",
                                       Collaborator::ACTIVE_WITHIN.in_days.to_i) %></p>
      <% if @memberships.any? %>
        <ul class="divide-y divide-border-light">
          <% @memberships.each do |membership| %>
            <% tool = membership.tool %>
            <li class="flex items-center gap-3 py-3 text-sm">
              <%= render "shared/icon", name: tool.tool_type.icon, size: 16, class: "text-accent flex-shrink-0" %>
              <div class="flex-1 min-w-0">
                <p class="text-text-primary truncate"><%= tool.name %></p>
                <p class="text-text-tertiary truncate">
                  <%= [ tool.tool_type.human_name,
                        (tool.mail_account.email_address if tool.mail_account),
                        membership.role == "owner" ? _("Owner") : _("Collaborator"),
                        n_("%{count} person", "%{count} people", @people_counts.fetch(tool.id, 0)) ].compact.join(" · ") %>
                </p>
              </div>
              <div class="text-end flex-shrink-0">
                <% if membership.active? %>
                  <%= render "components/badge", text: _("In use"), variant: :success, size: :sm %>
                <% end %>
                <p class="text-text-tertiary">
                  <%= membership.last_seen_at ? _("Opened %{time}", time: ago(membership.last_seen_at)) : _("Never opened") %>
                </p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-text-secondary"><%= _("No tools yet") %></p>
      <% end %>
    </div>
  </div>

  <% unless @user == current_user %>
    <div class="flex flex-wrap items-center gap-3">
      <%= form_with model: @user, url: admin_user_path(@user), method: :patch do |f| %>
        <%= hidden_field_tag "user[admin]", @user.admin? ? "0" : "1", id: nil %>
        <%= render "components/button", variant: :secondary, icon: "shield",
              text: @user.admin? ? _("No longer an admin") : _("Make an admin") %>
      <% end %>
      <%= render "components/button", text: _("Delete account"), variant: :danger, icon: "trash-2",
            href: admin_user_path(@user), method: :delete,
            turbo_confirm: _("Delete %{name}'s account? The tools only they own are deleted with it.", name: @user.name) %>
    </div>
  <% end %>
</div>
