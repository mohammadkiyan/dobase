<% content_for :title, _("Admin - %{app_name}", app_name: app_name) %>
<% content_for :page_title, _("Admin") %>

<div class="p-6 max-w-4xl">
  <%= render "admin/header" do %>
    <%= render "components/button", text: _("New template"), icon: "plus", href: new_admin_user_template_path %>
  <% end %>

  <% if @templates.any? %>
    <div class="card">
      <div class="divide-y divide-border-light">
        <% @templates.each do |template| %>
          <div class="card-row group px-5 py-4 flex items-center gap-4" data-arrow-keys-target="item">
            <div class="flex-1 min-w-0">
              <%= link_to template.name, edit_admin_user_template_path(template), class: "font-medium text-text-primary hover:text-accent after:absolute after:inset-0" %>
              <p class="text-sm text-text-secondary truncate">
                <%= [ *template.own_tools.map { |tool| tool["name"].presence || ToolType.find_by(slug: tool["type"])&.human_name },
                      (template.mail_tool_name.presence || _("Mail") if template.mail?),
                      *template.shared_tools.map(&:name) ].compact.join(" · ").presence || _("No tools") %>
              </p>
            </div>
            <%= render "shared/icon", name: "chevron-right", size: 16, class: "text-text-tertiary flex-shrink-0" %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="card">
      <%= render "components/empty_state",
          title: _("No templates yet"),
          description: _("A template says which tools a new person starts with."),
          icon: "layout",
          size: :md,
          action_text: _("New template"),
          action_href: new_admin_user_template_path,
          action_icon: "plus" %>
    </div>
  <% end %>
</div>
